<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- Mapperとxmlのマッピング -->
<mapper
	namespace="com.kokifujii.studyapp.user.repository.UserMapper">

	<!-- ユーザー登録SQL -->
	<insert id="insert">
		INSERT INTO users(
		user_name
		,email
		,password
		) VALUES (
		#{userName}
		,#{email}
		,#{password}
		)
	</insert>
</mapper>